# Copy to .env (git-ignored). Never commit real credentials.

# Password for the local docker-compose database. Generate one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# Postgres with pgvector (expands POSTGRES_PASSWORD when sourced by a shell or read by compose).
DATABASE_URL=postgresql://trustdesk:${POSTGRES_PASSWORD}@127.0.0.1:5432/trustdesk

# Bearer key required for /api and /mcp. Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# If left empty, `trustdesk serve` generates a random key at startup and prints it once.
TRUSTDESK_API_KEY=

# Set to true ONLY for throwaway local demos: disables authentication entirely.
# TRUSTDESK_ALLOW_ANONYMOUS=false

# Any OpenAI-compatible endpoint (LiteLLM, OpenAI, vLLM). Leave LLM_BASE_URL empty to use the
# built-in offline hash embedder (good for local dev and tests; lexical, not semantic).
LLM_BASE_URL=
LLM_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=768
